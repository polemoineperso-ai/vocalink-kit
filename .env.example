# Copiez ce fichier en .env et renseignez les vraies valeurs.

# Postgres (Neon, via l'intégration marketplace Vercel — voir README section
# Déploiement). DATABASE_URL = connexion poolée (usage applicatif normal),
# DATABASE_URL_UNPOOLED = connexion directe (migrations uniquement).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Transcription (src/lib/transcription.ts, API Whisper). Absente = message
# d'indisponibilité clair, pas de plantage.
OPENAI_API_KEY=""

# Classification + extraction (src/lib/classification.ts). Facultative :
# présente = Claude ; absente = OpenAI avec OPENAI_API_KEY ci-dessus (une
# seule clé suffit). Aucune des deux = transcription brute en repli.
ANTHROPIC_API_KEY=""
# Modèle OpenAI de classification (si pas de clé Anthropic). Vide = gpt-4.1-mini.
OPENAI_CLASSIFICATION_MODEL=""

# Synchronisation Notion des idées Projet (src/lib/notion.ts). L'une ou
# l'autre absente = idée enregistrée normalement, pas de synchro, pas
# d'erreur. Voir README pour la création de l'intégration + la base.
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# Digest email des idées PENDING oubliées (src/lib/mailer.ts, digest.ts).
# RESEND_API_KEY absente = email journalisé seulement, jamais envoyé.
RESEND_API_KEY=""
# Expéditeur, adresse d'un domaine vérifié sur Resend, ex.
# "Vocalink <digest@mondomaine.fr>". Vide = onboarding@resend.dev, qui n'envoie
# qu'à l'adresse du compte Resend.
DIGEST_FROM_EMAIL=""
# Adresse qui reçoit le digest.
DIGEST_TO_EMAIL=""
# Protège /api/cron/digest — absente, la route refuse tout appel (501),
# jamais "ouverte" par oubli.
CRON_SECRET=""
# Base des liens absolus dans l'email de digest. localhost convient pour une
# lecture depuis ce PC ; depuis un téléphone, mettre à jour avec l'URL du
# tunnel Cloudflare du moment (URL éphémère, change à chaque lancement) ; en
# production, l'adresse de votre app (ex. https://mon-vocalink.vercel.app).
APP_URL="http://localhost:3000"

# Mot de passe du formulaire de connexion (middleware.ts, cookie de session).
# Absente = app ouverte à tous, JAMAIS laisser vide en production.
APP_PASSWORD=""

# Synchronisation Google Tasks, TOUTES les idées (src/lib/google-tasks.ts).
# L'une des trois absente = idée enregistrée normalement, pas de synchro,
# pas d'erreur. Voir README pour la configuration OAuth (Google Cloud
# Console + scripts/get-google-refresh-token.mjs).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
