// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Générateur classique (pas le nouveau "prisma-client" ESM), éprouvé sur
// Vercel.
// Sortie par défaut (node_modules/@prisma/client) : Next.js a un support
// intégré pour bundler correctement le moteur natif à cet emplacement
// conventionnel, contrairement à un chemin de sortie personnalisé (source
// d'un bug de résolution de chemin rencontré avec le nouveau générateur).
generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local (Windows) — rhel-openssl-3.0.x pour le
  // runtime des fonctions Vercel (différent de la machine de build).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum IdeaCategory {
  PROJET
  EMAIL
  APPEL_RAPPEL
  IDEE_PURE
}

enum IdeaStatus {
  PENDING
  ACTIONED
}

enum IdeaPriority {
  LOW
  MEDIUM
  HIGH
}

// Cycle de vie d'une IDÉE (catégories Projet, Idée) : elle mûrit, elle ne
// se coche pas. Les ACTIONS (Email, Appel/Rappel) gardent `status`.
enum IdeaStage {
  NEW
  THINKING
  IN_PROGRESS
  DONE
  ARCHIVED
}

model Idea {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  status    IdeaStatus   @default(PENDING)
  stage     IdeaStage    @default(NEW)
  category  IdeaCategory
  priority  IdeaPriority @default(MEDIUM)

  transcript String
  title      String
  summary    String
  tags       String

  // Ancien champ "Destinataire" (nom ou email mélangés, catégorie Email
  // uniquement) — remplacé par le bloc contact ci-dessous, repris par la
  // migration add_contact_fields. Conservé en lecture seule, plus écrit.
  emailRecipient String?
  emailSubject   String?
  emailBody      String?

  // Contact lié à l'idée — toutes catégories, tous champs facultatifs.
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  contactCompany String?
  contactRole    String?

  dueAt        DateTime?
  dueEstimated Boolean @default(false)

  parentId String?
  parent   Idea?   @relation("IdeaParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Idea[]  @relation("IdeaParent")

  notionPageId  String?
  notionPageUrl String?

  googleTaskId String?

  // Dernière fois que l'idée a été traitée depuis « À redécouvrir »
  // (développée, remise à plus tard, archivée) : pas reproposée avant 14 jours.
  resurfacedAt DateTime?

  // Prochaine étape suggérée par l'IA (gardée pour ne pas la relancer à
  // chaque ouverture de la fiche) : texte, nature (email / call / think), date.
  nextStepTitle String?
  nextStepKind  String?
  nextStepWhy   String?

  notes IdeaNote[]
}

// Notes ajoutées à une idée au fil du temps (dictées ou écrites) : l'idée
// mûrit sans réécrire son résumé d'origine.
model IdeaNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  text      String
  // "voice" (dictée) ou "text" (écrite)
  source    String   @default("voice")

  @@index([ideaId, createdAt])
}

// Réglages de l'installation (une seule ligne, id = 1) — app mono-utilisateur.
model Settings {
  id          Int       @id @default(1)
  firstName   String?
  // Premier lancement terminé (écran d'accueil passé).
  onboardedAt DateTime?
  // Clés VAPID des notifications, générées automatiquement au premier
  // besoin : aucune variable d'environnement à configurer.
  vapidPublicKey  String?
  vapidPrivateKey String?
  // Dernier brief envoyé : Vercel Cron peut appeler deux fois le même jour.
  lastBriefAt DateTime?
  // Essais de mot de passe ratés d'affilée, et blocage temporaire qui en
  // découle (voir lib/login-throttle.ts).
  loginFailures     Int       @default(0)
  loginBlockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Appareils abonnés aux notifications (téléphone, ordinateur…).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
